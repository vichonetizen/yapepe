ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
GOOGLE_API_KEY=AIza-tu-clave-de-google-ai-studio-aqui
GROQ_API_KEY=gsk_tu-clave-de-groq-aqui
CLAUDE_MODEL=claude-sonnet-4-6
PORT=8000
# HOST es solo la direccion de BIND del servidor. La confianza se decide por
# peticion: los clientes que conectan desde loopback (127.0.0.1/::1) reciben el
# token en la pagina y acceso a /device/*; el resto no. Con HOST=0.0.0.0 la UI
# sigue funcionando desde 127.0.0.1, pero los visitantes de la LAN veran la
# pagina SIN token (la API les respondera 403): un despliegue realmente publico
# requiere autenticacion real.
HOST=127.0.0.1
# Token fijo para despliegues serverless (Vercel): MINIMO 32 caracteres.
# Si es mas corto se descarta con un warning y se genera uno fuerte local.
# LOCAL_TOKEN=
